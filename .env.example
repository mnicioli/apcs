# ============================================================================
# APCS — Atendimento Inteligente · variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha com os valores do SEU
# projeto Supabase (Dashboard > Project Settings > API).
#
#   cp .env.example .env.local        (Mac/Linux)
#   Copy-Item .env.example .env.local (Windows PowerShell)
#
# REGRA DE OURO: tudo que começa com NEXT_PUBLIC_ vai para o navegador e é
# PÚBLICO. NUNCA coloque a service_role key aqui nem em nada NEXT_PUBLIC_.
# ============================================================================

# URL do projeto Supabase (ex: https://xxxxxxxx.supabase.co) — PÚBLICA
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (anon/public key) — PÚBLICA, protegida por RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# Chat público (/chat) — todas SECRETAS, só server-side
# ----------------------------------------------------------------------------

# Chave service_role — SECRETA, ignora RLS.
# OBRIGATÓRIA para o chat: as tabelas do chat não têm policy de escrita para
# `anon`, então toda escrita passa pelo servidor com esta chave.
# Nunca prefixe com NEXT_PUBLIC_ e nunca comite o valor.
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API da Anthropic — usada pelo motor do chat para interpretar as
# mensagens (console.anthropic.com > API Keys).
# ⚠️ Configure também um LIMITE DE GASTO da organização no console da Anthropic:
# é o fusível de custo definitivo de um endpoint público que chama LLM.
ANTHROPIC_API_KEY=

# Modelo usado na interpretação. Opcional — o padrão é claude-opus-5.
# APCS_CHAT_MODEL=claude-opus-5

# Segredo do HMAC que anonimiza o IP usado no rate limit. Sem ele o hash é
# reversível por força bruta (IPv4 tem só 2^32 valores). Gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APCS_IP_HASH_SECRET=

# Link da política de privacidade da APCS, mostrado no pedido de consentimento.
APCS_PRIVACY_POLICY_URL=

# Versão da política vigente, registrada junto com cada consentimento (LGPD).
APCS_PRIVACY_POLICY_VERSION=1

# Link do material oficial do CSP enviado pelo bot.
APCS_CSP_MATERIAL_URL=
