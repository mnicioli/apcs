# ============================================================================
# APCS — Atendimento Inteligente · variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha com os valores do SEU
# projeto Supabase (Dashboard > Project Settings > API).
#
#   cp .env.example .env.local        (Mac/Linux)
#   Copy-Item .env.example .env.local (Windows PowerShell)
#
# REGRA DE OURO: tudo que começa com NEXT_PUBLIC_ vai para o navegador e é
# PÚBLICO. NUNCA coloque a service_role key aqui nem em nada NEXT_PUBLIC_.
# ============================================================================

# URL do projeto Supabase (ex: https://xxxxxxxx.supabase.co) — PÚBLICA
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (anon/public key) — PÚBLICA, protegida por RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do sistema (ex: https://apcs-sage.vercel.app) — PÚBLICO.
# Usado para montar o link do e-mail de recuperação de senha.
# ⚠️ CONFIGURE EM PRODUÇÃO. Sem ela, o endereço é deduzido do cabeçalho `Host`
# da requisição — que é escolhido por quem chama. Ver src/lib/http/site-url.ts.
# ⚠️ O mesmo endereço precisa estar em Authentication > URL Configuration >
# Redirect URLs no painel do Supabase, com `/auth/callback` no caminho:
#     https://SEU-DOMINIO/auth/callback
# Sem isso o Supabase ignora o `redirectTo` e devolve a pessoa para a Site URL.
# Na Vercel, em produção, existe uma rede de segurança: sem esta variável o
# sistema usa o domínio estável do projeto (`VERCEL_PROJECT_PRODUCTION_URL`) em
# vez do cabeçalho da requisição, para o link nunca sair apontando para
# `localhost`. A lista de Redirect URLs do painel continua obrigatória — essa
# parte não tem substituto no código.
NEXT_PUBLIC_SITE_URL=

# ----------------------------------------------------------------------------
# Atendimento automático (WhatsApp) — todas SECRETAS, só server-side
# ----------------------------------------------------------------------------

# Chave service_role — SECRETA, ignora RLS.
# OBRIGATÓRIA para o robô: ele atende quem não tem sessão, e as tabelas que ele
# lê e escreve não têm policy para `anon` — toda a escrita passa pelo servidor
# com esta chave.
# Nunca prefixe com NEXT_PUBLIC_ e nunca comite o valor.
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API da Anthropic — usada pelo robô para classificar as mensagens
# (console.anthropic.com > API Keys).
# ⚠️ Configure também um LIMITE DE GASTO da organização no console da Anthropic:
# é o fusível de custo definitivo de um endpoint público que chama LLM.
ANTHROPIC_API_KEY=

# Modelo usado na CLASSIFICAÇÃO DE INTENÇÕES. Opcional — o padrão é
# claude-sonnet-5, escolhido por custo.
# APCS_INTELLIGENCE_MODEL=claude-sonnet-5

# Segredo do HMAC que anonimiza o IP registrado no formulário público de
# associação (/associe-se). Sem ele o hash é
# reversível por força bruta (IPv4 tem só 2^32 valores). Gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APCS_IP_HASH_SECRET=


# ----------------------------------------------------------------------------
# Enquetes — disparo por WhatsApp e webhook (PROMPT 3/3)
# ----------------------------------------------------------------------------
# ⚠️ ENQUANTO ESTAS VARIÁVEIS NÃO EXISTIREM, O DISPARO NÃO ACONTECE — e é de
# propósito. O sistema recusa alto ("O envio por WhatsApp ainda não está
# integrado. Falta configurar: ...") em vez de marcar as pessoas como enviadas
# sem ter enviado nada. Ver docs/ENQUETES.md, seção 18.
#
# O resto do módulo funciona sem elas: criar, agendar, ativar, encerrar,
# responder pelo chat da web e ver resultados independem de mensageria.

# Qual adaptador usar. Padrão: whatsapp_cloud_api.
#   whatsapp_cloud_api → a API oficial da Meta
#   none               → desliga o disparo explicitamente
#   fake               → provedor em memória, para homologação local.
#                        IGNORADO em produção (ver src/lib/messaging/registry.ts).
# APCS_WHATSAPP_PROVIDER=whatsapp_cloud_api

# Token permanente do app da Meta (System User Access Token) — SECRETO.
APCS_WHATSAPP_TOKEN=

# Id do número de telefone no WhatsApp Business (Phone Number ID, não o número).
APCS_WHATSAPP_PHONE_NUMBER_ID=

# App Secret do app da Meta — SECRETO. É com ele que a assinatura
# `X-Hub-Signature-256` do webhook é conferida. Sem ele o webhook RECUSA tudo.
APCS_WHATSAPP_APP_SECRET=

# Token que você inventa e repete no painel da Meta ao cadastrar a URL do
# webhook. Serve só para o handshake de verificação (GET).
APCS_WHATSAPP_VERIFY_TOKEN=

# Segredo que autoriza as rotas de rotina (/api/jobs/surveys) — SECRETO.
# Sem ele a rota devolve 503 e NÃO roda: um endpoint aberto de disparo de
# WhatsApp custa dinheiro por conversa e queima a reputação do número.
# Gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No Vercel, `CRON_SECRET` também é aceita (é a que o Vercel Cron manda sozinho).
APCS_JOB_SECRET=

# ----------------------------------------------------------------------------
# WhatsApp via Z-API — a caixa de entrada do Atendimento
# ----------------------------------------------------------------------------
# É o fornecedor que a APCS contratou. Com ele configurado, TUDO passa a sair
# por ele: a caixa de entrada, o disparo de enquetes e as respostas do bot —
# é um número só, e um adaptador só por vez.
#
# Onde achar cada valor: painel da Z-API > Instâncias > a sua instância.

# Escolha explícita do adaptador. Sem ela o sistema usa o que estiver
# CONFIGURADO (ver src/lib/messaging/registry.ts); com os dois preenchidos,
# a escolha é ambígua e você precisa dizer qual quer.
#   z_api              → a Z-API (o que a APCS usa)
#   whatsapp_cloud_api → a API oficial da Meta
#   none               → desliga o WhatsApp explicitamente
#   fake               → provedor em memória. IGNORADO em produção.
APCS_WHATSAPP_PROVIDER=z_api

# Id da instância (aparece na URL do painel e nos exemplos de código) — SECRETO.
APCS_ZAPI_INSTANCE_ID=

# Token da instância — SECRETO. Quem tem o par id+token manda mensagem em nome
# da APCS. Nunca prefixe com NEXT_PUBLIC_ e nunca comite o valor.
APCS_ZAPI_TOKEN=

# Token de segurança da CONTA, mandado no header `Client-Token` — SECRETO.
# É outro token, e não o de cima: o de cima identifica a instância, este
# autoriza a conta.
APCS_ZAPI_CLIENT_TOKEN=

# ⚠️ O SEGREDO DO WEBHOOK. Vira um pedaço do CAMINHO da URL que você cadastra
# no painel da Z-API:
#
#   https://SEU-DOMINIO/api/webhooks/zapi/<este-valor>
#
# Ele existe porque a Z-API NÃO ASSINA os webhooks (a Meta assina; ela não).
# Sem ele, qualquer pessoa na internet poderia inserir na caixa de entrada uma
# mensagem que um associado nunca mandou. Consequência prática: a URL inteira é
# um segredo — ela não vai para print, chamado nem grupo de WhatsApp.
# Gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APCS_ZAPI_WEBHOOK_SECRET=
